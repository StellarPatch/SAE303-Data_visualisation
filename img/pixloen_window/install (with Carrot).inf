[Version]
signature="$CHICAGO$"
[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg = Scheme.Reg
[DestinationDirs]
Scheme.Cur = 10,"Cursors\[pixloen] Rice Shower"
[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","[pixloen] Rice Shower (Carrot)",0x00010000,"%10%\Cursors\[pixloen] Rice Shower\Normal Select.ani,%10%\Cursors\[pixloen] Rice Shower\Help Select.ani,%10%\Cursors\[pixloen] Rice Shower\Working In Background.ani,%10%\Cursors\[pixloen] Rice Shower\Busy.ani,%10%\Cursors\[pixloen] Rice Shower\Precision Select.ani,%10%\Cursors\[pixloen] Rice Shower\Text Select.ani,%10%\Cursors\[pixloen] Rice Shower\Handwriting.ani,%10%\Cursors\[pixloen] Rice Shower\Unavailable.ani,%10%\Cursors\[pixloen] Rice Shower\Vertical Resize.ani,%10%\Cursors\[pixloen] Rice Shower\Horizontal Resize.ani,%10%\Cursors\[pixloen] Rice Shower\Diagonal Resize 1.ani,%10%\Cursors\[pixloen] Rice Shower\Diagonal Resize 2.ani,%10%\Cursors\[pixloen] Rice Shower\Move.ani,%10%\Cursors\[pixloen] Rice Shower\Alternate Select.ani,%10%\Cursors\[pixloen] Rice Shower\Link Select.ani,%10%\Cursors\[pixloen] Rice Shower\Location Select.ani,%10%\Cursors\[pixloen] Rice Shower\Person Select.ani"
[Scheme.Cur]
Normal Select.ani,cursors\Normal Select.ani
Help Select.ani,cursors\Help Select.ani
Working In Background.ani,cursors\Working In Background.ani
Busy.ani,cursors\Busy.ani
Precision Select.ani,cursors\Precision Select.ani
Text Select.ani,cursors\Text Select.ani
Handwriting.ani,cursors\Handwriting.ani
Unavailable.ani,cursors\Unavailable.ani
Vertical Resize.ani,cursors\Vertical Resize.ani
Horizontal Resize.ani,cursors\Horizontal Resize.ani
Diagonal Resize 1.ani,cursors\Diagonal Resize 1.ani
Diagonal Resize 2.ani,cursors\Diagonal Resize 2.ani
Move.ani,cursors\Move.ani
Alternate Select.ani,cursors\Alternate Select.ani
Link Select.ani,cursors\Link Select.ani
Location Select.ani,cursors\Location Select.ani
Person Select.ani,cursors\Person Select.ani
